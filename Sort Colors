class Solution {
    public void sortColors(int[] nums) {
        int n = nums.length;
        int m = nums[0];
        for(int i=0;i<n;i++)
        {
            for(int j=0;j<n-i-1;j++)
            {
                if(nums[j]>nums[j+1])
                {
                    int tem = nums[j];
                    nums[j] = nums[j+1];
                    nums[j+1] = tem;
                }
            }
        }

        System.out.println(Arrays.toString(nums));
    }
}
