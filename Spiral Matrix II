class Solution {
    public int[][] generateMatrix(int n) {
        int list[][] = new int[n][n];
        int l = 0, r = n-1, t=0,b=n-1,count=1;
        while(count<=n*n)
        {
            for(int i=l;i<=r;i++)
            {
                list[t][i] = count++;
            }
            t++;
            for(int i=t;i<=b;i++)
            {
                list[i][r] = count++;
            }
            r--;
            for(int i=r;i>=l;i--)
                {
                    list[b][i] = count++;
                }
            b--;
            
            for(int i=b;i>=t;i--)
                {
                    list[i][l] = count++;
                }
                l++;
        }
        return list;
    }
}
