class Solution {
    public int singleNumber(int[] nums) {
        HashMap<Integer,Integer> h = new HashMap<>();
        int count = 0;
        int ans=0;
        for(int i=0;i<nums.length;i++)
        {
            h.put(nums[i],h.getOrDefault(nums[i],0)+1);
        }    
        for(int i:nums)
        {
            if(h.get(i)==1)
            {
                ans = i;
                break;
            }
        }    
        return ans;
    }
}
